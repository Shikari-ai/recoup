# Everything below is OPTIONAL. Recoup runs fully offline with no config:
#   python -m recoup backtest

# Enforce HMAC verification on POST /webhook/razorpay.
# RAZORPAY_WEBHOOK_SECRET=whsec_...

# Use a different compliance policy pack.
# RECOUP_POLICY_PACK=policies/in_default.toml

# Seconds between checks for an edited policy pack. The pack hot-reloads, and
# this throttles how often its file is stat-ed; 0 checks on every evaluation,
# which is measurably slower on a hot path. Default 1.0.
# RECOUP_POLICY_CHECK_INTERVAL_S=1.0

# Emergency stop: makes every guardrail deny every action.
# RECOUP_KILLSWITCH=1
