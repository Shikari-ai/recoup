__pycache__/
*.py[cod]
.pytest_cache/
# Tool caches. ruff and mypy each drop a self-ignoring .gitignore inside
# their own cache dir, so these are belt-and-braces -- but relying on a
# tool to hide its own droppings breaks the moment the tool changes or
# the tree is copied without it.
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
*.egg-info/
build/
dist/
.venv/
venv/
.env
.DS_Store
.idea/
.vscode/
# Large generated artifacts (ledgers, fitted weights). The committed evidence
# lives in results/ as plain text so it can be read and diffed in review.
artifacts/
*.jsonl
